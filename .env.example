# local: no API key, binds to the local SQLite database
# server: protects every /api/* route with DEVICE_API_KEY
APP_MODE=local

# SQLite database and uploaded images live below this directory
DATA_DIR=./data

# Required only when APP_MODE=server. Use at least 32 random bytes.
DEVICE_API_KEY=

# Public HTTPS origin used by remote clients, for example https://pet.example.com
PUBLIC_BASE_URL=

PORT=3000
